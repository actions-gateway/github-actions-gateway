.context
# Claude Code: default-ignore .claude/ runtime artifacts, allowlist shareable
# config back in. (.claude/* not .claude/ — git won't descend into a fully
# ignored dir, so the negations would be dead.)
.claude/*
!.claude/settings.json
!.claude/prod-guard.json
!.claude/foreground-guard.json
!.claude/commands/
!.claude/agents/
!.claude/skills/
!.claude/hooks/
# Credentials never tracked, even if nested in an allowlisted dir (last match wins).
.claude/**/.credentials.json
CLAUDE.local.md
# Scratch space for agent/dev temp files — keeps cp/mv/tee/rm and `>` redirects
# inside the workspace so claude-workspace-guard doesn't prompt. The .gitkeep is
# tracked so the dir exists on clone; everything else here is never tracked.
#
# Unanchored, so a scratch dir a `cd`-drifted command writes one level down
# (cmd/agc/tmp/, devtools/tmp/) is covered too — root-anchored, those were
# untracked-but-not-ignored, one directory `git add` from shipping (Q700).
# `**/tmp/*` not `**/tmp/` — git won't descend into a fully ignored dir, so the
# .gitkeep negation would be dead (same reason as .claude/* above).
**/tmp/*
!/tmp/.gitkeep
# binary build output
/.build/
# MkDocs site build output (CI builds to _site; local `mkdocs build` defaults to
# site/, with the dev publication scope alongside it in site-dev/)
/site/
/site-dev/
/_site/
/_site-dev/
# Local-build of the fakegithub helper (`make` at repo root drops it here);
# root-anchored so it doesn't shadow the test/fakegithub/ source directory.
/fakegithub
# stray binaries — always build via make build-* into .build/ instead
/cmd/agc/agc
/cmd/gmc/gmc
/cmd/probe/probe
/cmd/proxy/proxy
/cmd/worker/worker
# Python virtualenv + bytecode for the claude-usage/ charting scripts
# (README creates a .venv to install matplotlib/numpy). Unanchored so a venv
# under claude-usage/ is covered too; the committed data/ and charts/ outputs
# are not affected.
.venv/
__pycache__/
*.pyc
# MkDocs local preview: the isolated venv `make docs-serve` provisions from
# requirements-docs.txt, and the static build output `make docs-build` writes.
/.venv-docs/
/site/
# Go coverage profiles from a manual `go test -coverprofile`. scripts/go/coverage.sh
# writes its profiles to TMPDIR, never in-tree; this only catches stray manual
# runs. The committed coverage-baseline.txt (the ratchet floor) is NOT a profile
# and is intentionally tracked.
*.cover.out
coverage.out
cover.out

# Transient load-harness report from `make load-test-full` (Q13). The committed
# sample under cmd/agc/test/load/results/sample-run.md is the tracked artifact.
/cmd/agc/test/load/results/latest.md
