      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 46 },
      "id": 55,
      "description": "1 when WorkerCapacityDeclined=True: the opt-in capacity gate is refusing job intake. Present only for a RunnerSet that enables a gate, so 'No data' means no gate rather than a fault. The reason is shown alongside the value because it is what separates the latched AwaitingProbe state — intake throttled to one probe job per deadline window, which outlives the stuck pod that Workers unschedulable reports — from a live decline.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
