          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max by (reason) (actions_gateway_runnerset_worker_capacity_declined{namespace=~\"$namespace\", runner_set=~\"$runner_set\"})",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
