{
  "__inputs": [],
  "__requires": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Per-tenant reference dashboard for github-actions-gateway (Q186). Sourced from a tenant's AGC + egress-proxy metrics (per-tenant mTLS scrape): gateway health, pod-creation-latency SLO, job throughput, tenant health conditions, egress proxy, and kube-state-metrics proxy/quota. Uses the SLO recording rules from deploy/monitoring/prometheusrule.yaml where applicable. For the fleet view see grafana-dashboard-platform.json. See docs/operations/observability.md.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["actions-gateway"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data source",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values({__name__=~\"actions_gateway_active_sessions|actions_gateway_scaleset_jobs_assigned_total\"}, namespace)",
        "hide": 0,
        "includeAll": true,
        "label": "Namespace",
        "multi": true,
        "name": "namespace",
        "query": {
          "query": "label_values({__name__=~\"actions_gateway_active_sessions|actions_gateway_scaleset_jobs_assigned_total\"}, namespace)",
          "refId": "namespace"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(actions_gateway_active_sessions{namespace=~\"$namespace\"}, runner_group)",
        "hide": 0,
        "includeAll": true,
        "label": "Runner group",
        "multi": true,
        "name": "runner_group",
        "query": {
          "query": "label_values(actions_gateway_active_sessions{namespace=~\"$namespace\"}, runner_group)",
          "refId": "runner_group"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(actions_gateway_runnerset_worker_quota_pressure{namespace=~\"$namespace\"}, runner_set)",
        "hide": 0,
        "includeAll": true,
        "label": "Runner set",
        "multi": true,
        "name": "runner_set",
        "query": {
          "query": "label_values(actions_gateway_runnerset_worker_quota_pressure{namespace=~\"$namespace\"}, runner_set)",
          "refId": "runner_set"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "",
  "title": "Actions Gateway — Tenant",
  "uid": "actions-gateway-tenant",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "type": "row",
      "title": "Gateway Health (per namespace)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Active sessions",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (namespace, runner_group) (actions_gateway_active_sessions{namespace=~\"$namespace\", runner_group=~\"$runner_group\"})",
          "legendFormat": "{{namespace}}/{{runner_group}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Jobs acquired/min",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (namespace, runner_group) (rate(actions_gateway_jobs_acquired_total{namespace=~\"$namespace\", runner_group=~\"$runner_group\"}[5m])) * 60",
          "legendFormat": "{{namespace}}/{{runner_group}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Token refresh errors",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.0001 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (namespace) (rate(actions_gateway_token_refresh_errors_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "RenewJob errors",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.0001 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (namespace) (rate(actions_gateway_renew_job_errors_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Pod Creation Latency SLO",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 10,
      "panels": []
    },
    {
      "type": "gauge",
      "title": "p95 pod creation latency",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 8 },
      "id": 11,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 15 },
              { "color": "red", "value": 60 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "actions_gateway:pod_creation_latency_seconds:p95{namespace=~\"$namespace\"}",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "p99 pod creation latency",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 8 },
      "id": 12,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 15 },
              { "color": "red", "value": 60 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "actions_gateway:pod_creation_latency_seconds:p99{namespace=~\"$namespace\"}",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "heatmap",
      "title": "Pod creation latency heatmap",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 8 },
      "id": 13,
      "options": { "calculate": false, "cellGap": 1, "yAxis": { "unit": "s" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (le) (rate(actions_gateway_pod_creation_latency_seconds_bucket{namespace=~\"$namespace\"}[5m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Job Throughput (per runner_group)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 20,
      "panels": []
    },
    {
      "type": "barchart",
      "title": "Jobs acquired (1h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 16 },
      "id": 21,
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (runner_group) (increase(actions_gateway_jobs_acquired_total{namespace=~\"$namespace\", runner_group=~\"$runner_group\"}[1h]))",
          "legendFormat": "{{runner_group}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Job duration p50 / p95",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 16 },
      "id": 22,
      "description": "Worker pod lifetime on both acquisition tiers: creation to the last container finishing, or to the deletion request for a worker removed mid-run. The span changed in v1.5.0 (Q713) without a rename — the classic tier previously timed from job acquisition, so it also counted Secret staging, quota retries and any spec.scaleUp throttle wait, none of which a node bills for. Classic-tier p50/p95 step down at that upgrade, and so does anything costed off this series. The version panel below says which span you are reading.",
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "actions_gateway:job_duration_seconds:p50{namespace=~\"$namespace\", runner_group=~\"$runner_group\"}",
          "legendFormat": "p50 {{namespace}}/{{runner_group}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "actions_gateway:job_duration_seconds:p95{namespace=~\"$namespace\", runner_group=~\"$runner_group\"}",
          "legendFormat": "p95 {{namespace}}/{{runner_group}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Disruption retries (1h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 16 },
      "id": 23,
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (runner_group, tier, cause) (increase(actions_gateway_eviction_retries_total{namespace=~\"$namespace\", runner_group=~\"$runner_group\"}[1h]))",
          "legendFormat": "{{runner_group}} ({{tier}}/{{cause}})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Disruption budget exhausted (1h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 16 },
      "id": 24,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (namespace, runner_group) (increase(actions_gateway_eviction_retries_exhausted_total{namespace=~\"$namespace\", runner_group=~\"$runner_group\"}[1h]))",
          "legendFormat": "{{namespace}}/{{runner_group}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Abandoned runs awaiting capacity (1h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 23 },
      "id": 28,
      "description": "Force-cancelled abandoned runs waiting for the owner to place a worker pod again before their automatic re-run fires (Q691), split by acquisition tier since Q766 ported the recovery to scaleset. outcome=expired is the one to watch: nothing was placed inside the wait window, so the job is silently lost until someone re-runs it by hand. outcome=capacity_returned handed the re-run to the shared per-run retry budget, where it reports as cause=abandoned on the disruption-retries panel.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (runner_group, tier, outcome) (increase(actions_gateway_abandoned_run_rerun_waits_total{namespace=~\"$namespace\", runner_group=~\"$runner_group\"}[1h]))",
          "legendFormat": "{{runner_group}} ({{tier}}/{{outcome}})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "AGC / proxy version",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 23 },
      "id": 27,
      "description": "One series per running binary, from actions_gateway_build_info. Sits under the job-duration panel because it says which span that panel is measuring: v1.5.0 and later is worker pod lifetime on both tiers, earlier classic-tier data is the longer pre-Q713 span. The metric carries no namespace label, so $namespace does not filter it — every AGC and proxy this Prometheus scrapes is listed.",
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "actions_gateway_build_info{component=~\"agc|proxy\"}",
          "legendFormat": "{{component}} {{version}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Quota retries (1h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 23 },
      "id": 25,
      "description": "Pod creation attempts retried due to namespace ResourceQuota exhaustion.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (runner_group) (increase(actions_gateway_quota_retries_total{namespace=~\"$namespace\", runner_group=~\"$runner_group\"}[1h]))",
          "legendFormat": "{{runner_group}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Quota retry budget exhausted (1h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 23 },
      "id": 26,
      "description": "Jobs abandoned after exhausting the quota retry budget.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (namespace, runner_group) (increase(actions_gateway_quota_retries_exhausted_total{namespace=~\"$namespace\", runner_group=~\"$runner_group\"}[1h]))",
          "legendFormat": "{{namespace}}/{{runner_group}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Scale-set Acquisition Tier (per runner_set)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "id": 40,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Jobs assigned vs provisioned/min",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 31 },
      "id": 41,
      "description": "The default acquisition protocol (Q264). A ScaleSet-protocol RunnerSet emits no actions_gateway_active_sessions or jobs_acquired_total, so its throughput is only visible here. A persistent gap (assigned above provisioned) means provisioning is lagging — correlate with the provision-errors panel.",
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (namespace, runner_set) (rate(actions_gateway_scaleset_jobs_assigned_total{namespace=~\"$namespace\", runner_set=~\"$runner_set\"}[5m])) * 60",
          "legendFormat": "assigned {{namespace}}/{{runner_set}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (namespace, runner_set) (rate(actions_gateway_scaleset_jobs_provisioned_total{namespace=~\"$namespace\", runner_set=~\"$runner_set\"}[5m])) * 60",
          "legendFormat": "provisioned {{namespace}}/{{runner_set}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Provision success rate",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 31 },
      "id": 42,
      "description": "provisioned / (provisioned + provision errors), from the actions_gateway:scaleset_provision_success_rate:rate5m recording rule. The scale-set analog of the classic job-acquisition success rate.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.99 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "actions_gateway:scaleset_provision_success_rate:rate5m{namespace=~\"$namespace\"}",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Provision errors/s",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 31 },
      "id": 43,
      "description": "Failed provision attempts (JIT-config mint or worker pod create). A transient failure retries on a later poll; a sustained rate is alert-worthy (ActionsGatewayScaleSetProvisionErrors).",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.0001 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (namespace, runner_set) (rate(actions_gateway_scaleset_provision_errors_total{namespace=~\"$namespace\", runner_set=~\"$runner_set\"}[5m]))",
          "legendFormat": "{{namespace}}/{{runner_set}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Jobs completed by result (1h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 31 },
      "id": 44,
      "description": "Terminal JobCompleted messages by GitHub-reported result — the completion signal the classic many-acquirers protocol never delivered, unique to the scale-set tier.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (result) (increase(actions_gateway_scaleset_jobs_completed_total{namespace=~\"$namespace\"}[1h]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Worker pods reaped/s (by reason)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 38 },
      "id": 45,
      "description": "The reaper counter's per-RunnerSet series (runner_set label, Q514), joinable with the capacity gauges on (namespace, runner_set). The label keys on the owning kind, so a Classic-protocol RunnerSet appears here too. reason=orphaned_running and reason=completed_pending are the scale-set-only reaps: both read a job-completion annotation the classic tier never stamps.",
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (namespace, runner_set, reason) (rate(actions_gateway_worker_pods_reaped_total{namespace=~\"$namespace\", runner_set!=\"\", runner_set=~\"$runner_set\"}[5m]))",
          "legendFormat": "{{namespace}}/{{runner_set}} {{reason}}",
          "refId": "A"
        }
      ]
    },
