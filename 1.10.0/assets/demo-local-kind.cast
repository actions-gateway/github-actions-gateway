{"version": 2, "width": 100, "height": 27, "timestamp": 0, "env": {"TERM": "xterm-256color", "SHELL": "/bin/zsh"}, "title": "GitHub Actions Gateway \u2014 local kind demo"}
[0.0, "o", "\u001b[1;38;5;45m#  GitHub Actions Gateway — trigger one CI job, watch the pod:\u001b[0m\r\n"]
[2.2, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m gh workflow run test-job.yml --repo $ORG/$REPO --ref main"]
