{
  "env": {
    "PR_SENTINEL_TIMEOUT": "21600",
    "PR_SENTINEL_WATCH_UNTIL": "ready"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/agent/claude-go-throttle-hook.sh"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/agent/record-launch-guard.py\""
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/agent/claude-no-subagent-workers-hook.sh"
          }
        ]
      }
    ]
  }
}
