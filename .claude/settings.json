{
  "env": {
    "PR_SENTINEL_TIMEOUT": "21600",
    "PR_SENTINEL_WATCH_UNTIL": "closed"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/agent/claude-go-throttle-hook.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/agent/claude-piped-gate-hook.sh"
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/agent/claude-no-subagent-workers-hook.sh"
          }
        ]
      }
    ]
  }
}
