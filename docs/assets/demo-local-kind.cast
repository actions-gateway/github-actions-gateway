{"version": 2, "width": 100, "height": 26, "timestamp": 0, "env": {"TERM": "xterm-256color", "SHELL": "/bin/zsh"}, "title": "GitHub Actions Gateway \u2014 local kind demo"}
[0.0, "o", "\u001b[1;38;5;45m#  GitHub Actions Gateway — self-hosted CI runners on Kubernetes,\u001b[0m\r\n"]
[0.4, "o", "\u001b[1;38;5;45m#  with zero idle compute. Here's the whole idea in 30 seconds:\u001b[0m\r\n"]
[3.0, "o", "\u001b[1;38;5;45m#  GAG is installed and idle. How many runner pods are running? None:\u001b[0m\r\n"]
[4.9, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl get pods -n team-a"]
[5.4, "o", "\r\n"]
[6.1, "o", "NAME                                          READY   STATUS    RESTARTS   AGE\r\n"]
[6.2, "o", "actions-gateway-controller-79ccdddbcc-9phzv   1/1     Running   0          9m\r\n"]
[6.3, "o", "actions-gateway-proxy-5cfbb9584d-sjwjj        1/1     Running   0          9m\r\n"]
[7.3, "o", "\u001b[1;38;5;45m#  Just a lightweight controller and proxy. No runner sits idle —\u001b[0m\r\n"]
[7.7, "o", "\u001b[1;38;5;45m#  an idle team costs nothing: no reserved pods, no idle GPUs.\u001b[0m\r\n"]
[10.1, "o", "\r\n"]
[10.4, "o", "\u001b[1;38;5;45m#  Now trigger ONE real GitHub Actions job:\u001b[0m\r\n"]
[12.3, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m gh workflow run test-job.yml --repo $ORG/$REPO --ref main"]
[12.8, "o", "\r\n"]
[13.5, "o", "\u001b[38;5;245mhttps://github.com/$ORG/$REPO/actions/runs/28687049624\u001b[0m\r\n"]
[14.4, "o", "\u001b[1;38;5;45m#  GAG spins up a pod JUST for that job — watch it appear, run, and vanish:\u001b[0m\r\n"]
[16.3, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl get pods -n team-a -w"]
[16.8, "o", "\r\n"]
[17.5, "o", "NAME                                         READY   STATUS            AGE  \r\n"]
[17.85, "o", "actions-gateway-controller-79ccdddbcc-9phzv  1/1     Running           9m   \r\n"]
[18.1, "o", "actions-gateway-proxy-5cfbb9584d-sjwjj       1/1     Running           9m   \r\n"]
[19.5, "o", "runner-…-6d8749c-b0587c8-47200999            0/1     \u001b[33mPending\u001b[0m           0s   \u001b[38;5;245m← new pod for the job\u001b[0m\r\n"]
[21.1, "o", "runner-…-6d8749c-b0587c8-47200999            0/1     \u001b[33mContainerCreating\u001b[0m 1s   \r\n"]
[22.7, "o", "runner-…-6d8749c-b0587c8-47200999            1/1     \u001b[32mRunning\u001b[0m           3s   \u001b[38;5;245m← the job is executing\u001b[0m\r\n"]
[24.9, "o", "runner-…-6d8749c-b0587c8-47200999            0/1     \u001b[36mCompleted\u001b[0m         9s   \u001b[38;5;245m← job finished\u001b[0m\r\n"]
[26.5, "o", "runner-…-6d8749c-b0587c8-47200999            0/1     Terminating       9s   \u001b[38;5;245m← pod deleted instantly\u001b[0m\r\n"]
[28.3, "o", "\u001b[38;5;245m^C\u001b[0m\r\n"]
[29.2, "o", "\r\n"]
[29.5, "o", "\u001b[1;38;5;45m#  The job is green on GitHub — it really ran (~8 seconds):\u001b[0m\r\n"]
[31.4, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m gh run view 28687049624 --repo $ORG/$REPO"]
[31.9, "o", "\r\n"]
[32.6, "o", "\u001b[32m✓\u001b[0m main Test self-hosted runner · 28687049624\r\n"]
[32.7, "o", "Triggered via workflow_dispatch less than a minute ago\r\n"]
[32.8, "o", "\r\n"]
[32.9, "o", "JOBS\r\n"]
[33.0, "o", "\u001b[32m✓\u001b[0m test in 8s (ID 85081558995)\r\n"]
[34.5, "o", "\u001b[1;38;5;45m#  One job → one short-lived pod → green → back to zero.\u001b[0m\r\n"]
[34.9, "o", "\u001b[1;38;5;45m#  You pay for compute only while a job runs. That's GAG.\u001b[0m\r\n"]
