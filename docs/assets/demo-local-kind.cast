{"version": 2, "width": 100, "height": 32, "timestamp": 0, "env": {"TERM": "xterm-256color", "SHELL": "/bin/zsh"}, "title": "GitHub Actions Gateway \u2014 local kind demo"}
[0.0, "o", "\u001b[1;38;5;45m# ──────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[0.42, "o", "\u001b[1;38;5;45m#  GitHub Actions Gateway (GAG)\u001b[0m\r\n"]
[0.84, "o", "\u001b[1;38;5;45m#  Self-hosted GitHub Actions runners on Kubernetes — with zero idle compute.\u001b[0m\r\n"]
[1.26, "o", "\u001b[1;38;5;45m# ──────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[3.88, "o", "\u001b[1;38;5;45m#  In this short demo, on a cluster running on a laptop:\u001b[0m\r\n"]
[4.3, "o", "\u001b[1;38;5;45m#    a single real GitHub job runs in a pod that exists ONLY while the job runs,\u001b[0m\r\n"]
[4.72, "o", "\u001b[1;38;5;45m#    then disappears. No runner sits idle waiting. That is the whole idea.\u001b[0m\r\n"]
[7.54, "o", "\r\n"]
[7.94, "o", "\u001b[1;38;5;45m#  STEP 1 — Create a throwaway Kubernetes cluster and install GAG.\u001b[0m\r\n"]
[8.36, "o", "\u001b[1;38;5;45m#  (kind runs a real cluster locally; GAG installs as a single controller.)\u001b[0m\r\n"]
[10.48, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m make e2e-cluster"]
[10.98, "o", "\r\n"]
[11.73, "o", "Creating cluster \"actions-gateway-e2e\" ...\r\n"]
[11.85, "o", " ✓ Preparing nodes 📦 📦 📦\r\n"]
[11.97, "o", " ✓ Starting control-plane 🕹️\r\n"]
[12.09, "o", " ✓ Installing CNI 🔌\r\n"]
[12.21, "o", " ✓ Joining worker nodes 🚜\r\n"]
[12.33, "o", "Set kubectl context to \"kind-actions-gateway-e2e\"\r\n"]
[13.45, "o", "\u001b[1;38;5;45m#  The cluster is up — one control-plane node and two workers.\u001b[0m\r\n"]
[15.47, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl get nodes"]
[15.97, "o", "\r\n"]
[16.72, "o", "NAME                                STATUS   ROLES           AGE   VERSION\r\n"]
[16.84, "o", "actions-gateway-e2e-control-plane   Ready    control-plane   3m    v1.35.0\r\n"]
[16.96, "o", "actions-gateway-e2e-worker          Ready    <none>          3m    v1.35.0\r\n"]
[17.08, "o", "actions-gateway-e2e-worker2         Ready    <none>          3m    v1.35.0\r\n"]
[18.2, "o", "\u001b[1;38;5;45m#  Now install the platform itself — the Gateway Manager Controller —\u001b[0m\r\n"]
[18.62, "o", "\u001b[1;38;5;45m#  with one Helm command. This is the only thing installed cluster-wide.\u001b[0m\r\n"]
[20.74, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m make e2e-images   \u001b[38;5;245m# build the gmc/agc/proxy/worker images\u001b[0m"]
[21.24, "o", "\r\n"]
[21.84, "o", "#62 pushing manifest for 127.0.0.1:5000/gmc:e2e ... done\r\n"]
[21.96, "o", " ✓ gmc  ✓ agc  ✓ proxy  ✓ worker  ✓ wrapper  →  127.0.0.1:5000\r\n"]
[23.08, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m helm upgrade --install actions-gateway charts/actions-gateway \\\r\n    -n gmc-system --create-namespace ..."]
[23.58, "o", "\r\n"]
[24.33, "o", "Release \"actions-gateway\" does not exist. Installing it now.\r\n"]
[24.45, "o", "NAME: actions-gateway\r\n"]
[24.57, "o", "STATUS: deployed\r\n"]
[25.69, "o", "\u001b[1;38;5;45m#  One controller now manages runners for every team on this cluster.\u001b[0m\r\n"]
[27.71, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl get pods -n gmc-system"]
[28.21, "o", "\r\n"]
[28.96, "o", "NAME                                      READY   STATUS    RESTARTS   AGE\r\n"]
[29.08, "o", "gmc-controller-manager-675d44bd57-9phn4   1/1     Running   0          70s\r\n"]
[29.2, "o", "gmc-controller-manager-675d44bd57-gmp8f   1/1     Running   0          63s\r\n"]
[30.32, "o", "\r\n"]
[30.72, "o", "\u001b[1;38;5;45m#  STEP 2 — Onboard a team, \"team-a\".\u001b[0m\r\n"]
[31.14, "o", "\u001b[1;38;5;45m#  A whole team's runner setup is a namespace, a budget, a secret, and ONE resource.\u001b[0m\r\n"]
[33.26, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl create namespace team-a"]
[33.76, "o", "\r\n"]
[34.51, "o", "namespace/team-a created\r\n"]
[35.13, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl label ns team-a actions-gateway.github.com/tenant=true"]
[35.63, "o", "\r\n"]
[36.38, "o", "namespace/team-a labeled\r\n"]
[37.3, "o", "\u001b[1;38;5;45m#  Give the team a compute budget the platform owns — the team can't exceed it.\u001b[0m\r\n"]
[39.32, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl apply -f tenant-quota.yaml   \u001b[38;5;245m# ResourceQuota + LimitRange\u001b[0m"]
[39.82, "o", "\r\n"]
[40.32, "o", "resourcequota/team-a-quota created\r\n"]
[40.44, "o", "limitrange/team-a-defaults created\r\n"]
[41.56, "o", "\u001b[1;38;5;45m#  Add the team's GitHub App credentials as a Secret (read from a file, never inline).\u001b[0m\r\n"]
[43.58, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl create secret generic team-a-github-app -n team-a \\\r\n    --from-literal=appId=\"$APP_ID\" --from-literal=installationId=\"$INSTALL_ID\" \\\r\n    --from-file=privateKey=app.pem"]
[44.08, "o", "\r\n"]
[44.83, "o", "secret/team-a-github-app created\r\n"]
[45.95, "o", "\u001b[1;38;5;45m#  Finally, ONE resource describes the team's runners: labels, size, and\u001b[0m\r\n"]
[46.37, "o", "\u001b[1;38;5;45m#  \"completedPodTTL: 0s\" — delete each job's pod the instant it finishes.\u001b[0m\r\n"]
[48.49, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl apply -f actionsgateway.yaml"]
[48.99, "o", "\r\n"]
[49.74, "o", "actionsgateway.actions-gateway.github.com/team-a-gateway created\r\n"]
[51.06, "o", "\r\n"]
[51.46, "o", "\u001b[1;38;5;45m#  GAG reacts automatically: it stands up the team's runner controller and\u001b[0m\r\n"]
[51.88, "o", "\u001b[1;38;5;45m#  egress proxy, and registers self-hosted runners with GitHub.\u001b[0m\r\n"]
[54.0, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl get actionsgateway,runnergroup -n team-a"]
[54.5, "o", "\r\n"]
[55.25, "o", "NAME                                                    PROXYREADY   READY   AGE\r\n"]
[55.37, "o", "actionsgateway.../team-a-gateway                        1            \u001b[32mTrue\u001b[0m    2m\r\n"]
[55.49, "o", "\r\n"]
[55.61, "o", "NAME                                            MAXLISTENERS  ACTIVESESSIONS  ACTIVEJOBS  READY\r\n"]
[55.73, "o", "runnergroup.../team-a-gateway-e2e-6d8749c       2             2               0           \u001b[32mTrue\u001b[0m\r\n"]
[56.85, "o", "\u001b[1;38;5;45m#  GitHub now sees the team's runners as online and idle:\u001b[0m\r\n"]
[58.67, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m gh api repos/$ORG/$REPO/actions/runners --jq '.runners[] | ...'"]
[59.17, "o", "\r\n"]
[59.92, "o", "team-a-gateway-e2e-6d8749c-0   \u001b[32monline\u001b[0m   idle   e2e\r\n"]
[60.04, "o", "team-a-gateway-e2e-6d8749c-1   \u001b[32monline\u001b[0m   idle   e2e\r\n"]
[61.56, "o", "\u001b[1;38;5;45m#  The important part — look at the team's pods right now:\u001b[0m\r\n"]
[61.98, "o", "\u001b[1;38;5;45m#  the controller and proxy are running, but there are \u001b[1;38;5;45mZERO job pods.\u001b[0m\u001b[0m\r\n"]
[62.4, "o", "\u001b[1;38;5;45m#  An idle team costs nothing: no reserved runners, no idle GPUs.\u001b[0m\r\n"]
[64.52, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl get pods -n team-a"]
[65.02, "o", "\r\n"]
[65.77, "o", "NAME                                          READY   STATUS    RESTARTS   AGE\r\n"]
[65.89, "o", "actions-gateway-controller-79ccdddbcc-9phzv   1/1     Running   0          2m\r\n"]
[66.01, "o", "actions-gateway-proxy-5cfbb9584d-sjwjj        1/1     Running   0          2m\r\n"]
[68.53, "o", "\r\n"]
[68.93, "o", "\u001b[1;38;5;45m#  STEP 3 — Trigger ONE real GitHub Actions job and watch what happens.\u001b[0m\r\n"]
[71.05, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m gh workflow run test-job.yml --repo $ORG/$REPO --ref main"]
[71.55, "o", "\r\n"]
[72.3, "o", "\u001b[32m✓\u001b[0m Created workflow_dispatch event for test-job.yml at main\r\n"]
[73.42, "o", "\u001b[1;38;5;45m#  GAG picks up the job and creates a pod JUST for it. We'll watch the pods live:\u001b[0m\r\n"]
[75.54, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl get pods -n team-a -w"]
[76.04, "o", "\r\n"]
[76.74, "o", "NAME                                         READY   STATUS            AGE  \r\n"]
[77.14, "o", "actions-gateway-controller-79ccdddbcc-9phzv  1/1     Running           2m   \r\n"]
[77.44, "o", "actions-gateway-proxy-5cfbb9584d-sjwjj       1/1     Running           2m   \r\n"]
[79.04, "o", "runner-…-6d8749c-b0587c8-47200999            0/1     \u001b[33mPending\u001b[0m           0s   \u001b[38;5;245m← new pod for the job\u001b[0m\r\n"]
[81.04, "o", "runner-…-6d8749c-b0587c8-47200999            0/1     \u001b[33mContainerCreating\u001b[0m 1s   \r\n"]
[83.04, "o", "runner-…-6d8749c-b0587c8-47200999            1/1     \u001b[32mRunning\u001b[0m           3s   \u001b[38;5;245m← the job is executing\u001b[0m\r\n"]
[85.64, "o", "runner-…-6d8749c-b0587c8-47200999            0/1     \u001b[36mCompleted\u001b[0m         9s   \u001b[38;5;245m← job finished\u001b[0m\r\n"]
[87.64, "o", "runner-…-6d8749c-b0587c8-47200999            0/1     Terminating       9s   \u001b[38;5;245m← pod deleted instantly\u001b[0m\r\n"]
[89.84, "o", "\u001b[38;5;245m^C\u001b[0m\r\n"]
[90.74, "o", "\u001b[1;38;5;45m#  That is the whole pitch: one job → one short-lived pod → gone.\u001b[0m\r\n"]
[91.16, "o", "\u001b[1;38;5;45m#  You pay for compute only during the ~8 seconds the job actually ran.\u001b[0m\r\n"]
[93.98, "o", "\r\n"]
[94.38, "o", "\u001b[1;38;5;45m#  Meanwhile, on GitHub, the job is green:\u001b[0m\r\n"]
[96.2, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m gh run view 28687049624 --repo $ORG/$REPO"]
[96.7, "o", "\r\n"]
[97.45, "o", "\u001b[32m✓\u001b[0m main Test self-hosted runner · 28687049624\r\n"]
[97.57, "o", "Triggered via workflow_dispatch less than a minute ago\r\n"]
[97.69, "o", "\r\n"]
[97.81, "o", "JOBS\r\n"]
[97.93, "o", "\u001b[32m✓\u001b[0m test in 8s (ID 85081558995)\r\n"]
[99.85, "o", "\u001b[1;38;5;45m#  And the team's namespace is back to just the controller and proxy — no job pods.\u001b[0m\r\n"]
[101.87, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl get pods -n team-a"]
[102.37, "o", "\r\n"]
[103.12, "o", "NAME                                          READY   STATUS    RESTARTS   AGE\r\n"]
[103.24, "o", "actions-gateway-controller-79ccdddbcc-9phzv   1/1     Running   0          3m\r\n"]
[103.36, "o", "actions-gateway-proxy-5cfbb9584d-sjwjj        1/1     Running   0          3m\r\n"]
[105.48, "o", "\r\n"]
[105.88, "o", "\u001b[1;38;5;45m# ──────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[106.3, "o", "\u001b[1;38;5;45m#  One job  →  one short-lived pod  →  green on GitHub  →  back to zero.\u001b[0m\r\n"]
[106.72, "o", "\u001b[1;38;5;45m#  No idle runners. No idle GPUs. Runners scale to zero by default.\u001b[0m\r\n"]
[107.14, "o", "\u001b[1;38;5;45m# ──────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
