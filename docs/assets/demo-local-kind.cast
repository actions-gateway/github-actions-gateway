{"version": 2, "width": 92, "height": 30, "timestamp": 0, "env": {"TERM": "xterm-256color", "SHELL": "/bin/zsh"}, "title": "GitHub Actions Gateway \u2014 local kind demo"}
[0.0, "o", "\u001b[38;5;245m# GitHub Actions Gateway — end-to-end demo on a local kind cluster\u001b[0m\r\n"]
[0.35, "o", "\u001b[38;5;245m# One GitHub job  →  one ephemeral worker pod  →  green on real GitHub.\u001b[0m\r\n"]
[0.7, "o", "\u001b[38;5;245m# Every line below is from a real run (kind + real GitHub, no fakes).\u001b[0m\r\n"]
[2.45, "o", "\u001b[38;5;245m# 1) Stand up a kind cluster and install the platform (GMC).\u001b[0m\r\n"]
[3.6, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m make e2e-cluster"]
[4.1, "o", "\r\n"]
[4.7, "o", "Creating cluster \"actions-gateway-e2e\" ...\r\n"]
[4.82, "o", " ✓ Preparing nodes 📦 📦 📦\r\n"]
[4.94, "o", " ✓ Starting control-plane 🕹️\r\n"]
[5.06, "o", " ✓ Installing CNI 🔌\r\n"]
[5.18, "o", " ✓ Joining worker nodes 🚜\r\n"]
[5.3, "o", "Set kubectl context to \"kind-actions-gateway-e2e\"\r\n"]
[6.22, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl get nodes"]
[6.72, "o", "\r\n"]
[7.32, "o", "NAME                                STATUS   ROLES           AGE   VERSION\r\n"]
[7.44, "o", "actions-gateway-e2e-control-plane   Ready    control-plane   3m    v1.35.0\r\n"]
[7.56, "o", "actions-gateway-e2e-worker          Ready    <none>          3m    v1.35.0\r\n"]
[7.68, "o", "actions-gateway-e2e-worker2         Ready    <none>          3m    v1.35.0\r\n"]
[8.6, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m make e2e-images   \u001b[38;5;245m# build gmc/agc/proxy/worker → local registry\u001b[0m"]
[9.1, "o", "\r\n"]
[9.5, "o", "#62 pushing manifest for 127.0.0.1:5000/gmc:e2e ... done\r\n"]
[9.62, "o", " ✓ gmc  ✓ agc  ✓ proxy  ✓ worker  ✓ wrapper  →  127.0.0.1:5000\r\n"]
[10.24, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m helm upgrade --install actions-gateway charts/actions-gateway \\\n    -n gmc-system --create-namespace --set allowFloatingImageTags=true ..."]
[10.74, "o", "\r\n"]
[11.34, "o", "Release \"actions-gateway\" does not exist. Installing it now.\r\n"]
[11.46, "o", "NAME: actions-gateway\r\n"]
[11.58, "o", "STATUS: deployed\r\n"]
[11.7, "o", "NOTES: actions-gateway (Gateway Manager Controller) installed into \"gmc-system\".\r\n"]
[12.62, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl get pods -n gmc-system"]
[13.12, "o", "\r\n"]
[13.72, "o", "NAME                                      READY   STATUS    RESTARTS   AGE\r\n"]
[13.84, "o", "gmc-controller-manager-675d44bd57-9phn4   1/1     Running   0          70s\r\n"]
[13.96, "o", "gmc-controller-manager-675d44bd57-gmp8f   1/1     Running   0          63s\r\n"]
[14.88, "o", "\u001b[38;5;245m\u001b[0m\r\n"]
[15.23, "o", "\u001b[38;5;245m# 2) Onboard a tenant: namespace + quota, GitHub App secret, one CR.\u001b[0m\r\n"]
[16.38, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl create namespace team-a"]
[16.88, "o", "\r\n"]
[17.48, "o", "namespace/team-a created\r\n"]
[17.9, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl label ns team-a actions-gateway.github.com/tenant=true"]
[18.4, "o", "\r\n"]
[19.0, "o", "namespace/team-a labeled\r\n"]
[19.42, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl apply -f tenant-quota.yaml   \u001b[38;5;245m# ResourceQuota + LimitRange\u001b[0m"]
[19.92, "o", "\r\n"]
[20.22, "o", "resourcequota/team-a-quota created\r\n"]
[20.34, "o", "limitrange/team-a-defaults created\r\n"]
[20.86, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl create secret generic team-a-github-app -n team-a \\\n    --from-literal=appId=\"$APP_ID\" --from-literal=installationId=\"$INSTALL_ID\" \\\n    --from-file=privateKey=app.pem"]
[21.36, "o", "\r\n"]
[21.96, "o", "secret/team-a-github-app created\r\n"]
[22.48, "o", "\u001b[38;5;245m  # ActionsGateway CR: 1 runner group, labels [e2e], completedPodTTL: 0s\u001b[0m\r\n"]
[23.23, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl apply -f actionsgateway.yaml"]
[23.73, "o", "\r\n"]
[24.33, "o", "actionsgateway.actions-gateway.github.com/team-a-gateway created\r\n"]
[25.05, "o", "\u001b[38;5;245m\u001b[0m\r\n"]
[25.4, "o", "\u001b[38;5;245m# 3) The GMC provisions the AGC + egress proxy and registers runners.\u001b[0m\r\n"]
[26.55, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl get actionsgateway,runnergroup -n team-a"]
[27.05, "o", "\r\n"]
[27.65, "o", "NAME                                                    PROXYREADY   READY   AGE\r\n"]
[27.77, "o", "actionsgateway.../team-a-gateway                        1            True    2m\r\n"]
[27.89, "o", "\r\n"]
[28.01, "o", "NAME                                            MAXLISTENERS  ACTIVESESSIONS  ACTIVEJOBS  READY\r\n"]
[28.13, "o", "runnergroup.../team-a-gateway-e2e-6d8749c       2             2               0           True\r\n"]
[29.05, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m gh api repos/$ORG/$REPO/actions/runners --jq '.runners[] | ...'"]
[29.55, "o", "\r\n"]
[30.15, "o", "team-a-gateway-e2e-6d8749c-0   \u001b[32monline\u001b[0m   idle   e2e\r\n"]
[30.27, "o", "team-a-gateway-e2e-6d8749c-1   \u001b[32monline\u001b[0m   idle   e2e\r\n"]
[30.99, "o", "\u001b[38;5;245m  # Idle: the controller + proxy are up, but ZERO worker pods exist yet.\u001b[0m\r\n"]
[31.84, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl get pods -n team-a"]
[32.34, "o", "\r\n"]
[32.94, "o", "NAME                                          READY   STATUS    RESTARTS   AGE\r\n"]
[33.06, "o", "actions-gateway-controller-79ccdddbcc-9phzv   1/1     Running   0          2m\r\n"]
[33.18, "o", "actions-gateway-proxy-5cfbb9584d-sjwjj        1/1     Running   0          2m\r\n"]
[34.3, "o", "\u001b[38;5;245m\u001b[0m\r\n"]
[34.65, "o", "\u001b[38;5;245m# 4) Trigger one workflow job on real GitHub and watch the pod lifecycle.\u001b[0m\r\n"]
[35.8, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m gh workflow run test-job.yml --repo $ORG/$REPO --ref main"]
[36.3, "o", "\r\n"]
[36.9, "o", "✓ Created workflow_dispatch event for test-job.yml at main\r\n"]
[37.52, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl get pods -n team-a -w"]
[38.02, "o", "\r\n"]
[38.52, "o", "NAME                                                    READY   STATUS    AGE\r\n"]
[38.82, "o", "actions-gateway-controller-79ccdddbcc-9phzv             1/1     Running   2m\r\n"]
[39.02, "o", "actions-gateway-proxy-5cfbb9584d-sjwjj                  1/1     Running   2m\r\n"]
[40.22, "o", "runner-...-6d8749c-b0587c8-47200999   0/1     \u001b[33mPending\u001b[0m             0s\r\n"]
[41.62, "o", "runner-...-6d8749c-b0587c8-47200999   0/1     \u001b[33mContainerCreating\u001b[0m   1s\r\n"]
[43.22, "o", "runner-...-6d8749c-b0587c8-47200999   1/1     \u001b[32mRunning\u001b[0m             3s   \u001b[38;5;245m← job executing\u001b[0m\r\n"]
[45.42, "o", "runner-...-6d8749c-b0587c8-47200999   0/1     \u001b[36mCompleted\u001b[0m           9s\r\n"]
[46.62, "o", "runner-...-6d8749c-b0587c8-47200999   0/1     Terminating         9s   \u001b[38;5;245m← reaped on completion\u001b[0m\r\n"]
[48.02, "o", "\u001b[38;5;245m^C\u001b[0m\r\n"]
[48.82, "o", "\u001b[38;5;245m\u001b[0m\r\n"]
[49.17, "o", "\u001b[38;5;245m# 5) The job is green on GitHub, and compute is back to zero.\u001b[0m\r\n"]
[50.32, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m gh run view 28687049624 --repo $ORG/$REPO"]
[50.82, "o", "\r\n"]
[51.42, "o", "\u001b[32m✓\u001b[0m main Test self-hosted runner · 28687049624\r\n"]
[51.54, "o", "Triggered via workflow_dispatch less than a minute ago\r\n"]
[51.66, "o", "\r\n"]
[51.78, "o", "JOBS\r\n"]
[51.9, "o", "\u001b[32m✓\u001b[0m test in 8s (ID 85081558995)\r\n"]
[52.82, "o", "\u001b[1;32m➜\u001b[0m \u001b[1;36mgag-demo\u001b[0m \u001b[1;34m$\u001b[0m kubectl get pods -n team-a"]
[53.32, "o", "\r\n"]
[53.92, "o", "NAME                                          READY   STATUS    RESTARTS   AGE\r\n"]
[54.04, "o", "actions-gateway-controller-79ccdddbcc-9phzv   1/1     Running   0          3m\r\n"]
[54.16, "o", "actions-gateway-proxy-5cfbb9584d-sjwjj        1/1     Running   0          3m\r\n"]
[54.88, "o", "\u001b[38;5;245m  # The worker pod is gone — no idle compute between jobs.\u001b[0m\r\n"]
[55.23, "o", "\u001b[38;5;245m\u001b[0m\r\n"]
[55.58, "o", "\u001b[38;5;245m\u001b[32m# job → ephemeral pod → green on real GitHub → scaled back to zero.\u001b[0m\u001b[0m\r\n"]
