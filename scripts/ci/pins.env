# Tool and image pins the CI workflows read, one KEY=value per line.
#
# They live here rather than in the workflows because updatecli bumps them with
# the workflow's GITHUB_TOKEN, and GitHub refuses that token any write under
# .github/workflows/ (Q1166). Each consuming job loads this file after checkout
# with scripts/ci/load-pins.sh, which exports every key to the job's env and to
# its `pins` step outputs. Keys must end in _VERSION, _SHA256 or _IMAGE.
#
# Every *_SHA256 verifies a download whose release assets stay mutable for an
# existing tag (Q127), so the bytes are checked before the binary is trusted.

# Builder image docker/setup-buildx-action boots from, in the e2e, security-scan
# and publish workflows. DIGEST-PINNED (Q151): the buildx-stable-1 tag floats, so
# an unpinned reference would let the builder that assembles signed release
# images change underfoot. Bumped by updatecli.d/buildkit.yaml.
BUILDKIT_IMAGE=moby/buildkit:buildx-stable-1@sha256:0168606be2315b7c807a03b3d8aa79beefdb31c98740cebdffdfeebf31190c9f

# Calico release for the e2e egress-enforcing profile (KIND_CNI=calico). Keys the
# Calico image cache and pins the version passed to `make e2e-cluster`.
# Bumped with the root Makefile's CALICO_VERSION by updatecli.d/calico.yaml.
CALICO_VERSION=v3.31.5

# cosign release publish.yml signs with. `make cosign-pin-check` holds it to the
# Makefile's COSIGN_VERSION, the local verifier. Bumped with that copy and the
# digests in scripts/release/download-cosign.sh by updatecli.d/cosign.yaml.
COSIGN_VERSION=v2.5.2

# Kubernetes version of the envtest binaries the integration tier runs against.
# The envtest twin of KIND_NODE_IMAGE: keep both on the same minor. Multi-gateway
# AGC scoping (KEP-4358 field selectors) needs >= 1.31. The ".x" lets
# setup-envtest pick the newest patch. Bumped with cmd/{gmc,agc}/Makefile by
# updatecli.d/envtest.yaml.
ENVTEST_K8S_VERSION=1.35.x

# kind release for the e2e and live-autoscaler drift lanes, and the SHA256 of its
# linux/amd64 binary. KIND_NODE_IMAGE stays in e2e-reusable.yml and is bumped by
# hand. Bumped by updatecli.d/kind.yaml.
KIND_VERSION=v0.32.0
KIND_BINARY_SHA256=50030de23cf40a18505f20426f6a8506bedf13c6e509244bd1fa9463721b0f54

# polaris release security-scan.yml scans with, and the SHA256 of its
# linux/amd64 tarball from the release's checksums.txt. New checks can change the
# verdict, so review a bump. Bumped by updatecli.d/polaris.yaml.
POLARIS_VERSION=v10.2.5
POLARIS_SHA256=c264fc682fe612732e8a97680451d6e5f6b6fb920936215d6bb9ef387c7eadce

# shellcheck release the `shellcheck` and `actionlint` jobs install, rather than
# ubuntu-latest's preinstalled copy, whose heuristics drift with the runner image.
# The SHA256 is of the linux.x86_64 tarball; shellcheck publishes no checksum
# file, so updatecli.d/shellcheck.yaml hashes the tarball directly.
SHELLCHECK_VERSION=v0.11.0
SHELLCHECK_SHA256=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198

# syft release that generates SBOMs at PR time (security-scan.yml) and release
# time (publish.yml), and the SHA256 of its linux/amd64 tarball from the
# release's checksums file. Bumped by updatecli.d/syft.yaml.
SYFT_VERSION=v1.45.1
SYFT_SHA256=20c84195e24927f50a3b2269946be51f4c4abc9d2f145fee7388b4199149f716
