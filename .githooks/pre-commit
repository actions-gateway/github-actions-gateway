#!/usr/bin/env bash
# Fast pre-commit gate — the cheapest backpressure, run at commit time so
# trivially-fixable mistakes never cost a CI round-trip. Kept sub-second on
# purpose: the slower checks (golangci-lint, unit tests, govulncheck) live in
# `make check` and CI, so this hook stays fast enough that nobody reaches for
# --no-verify out of habit. Bypass a single commit with `git commit --no-verify`.
#
# Installed by `make hooks` or scripts/dev/setup.sh, both of which point
# core.hooksPath at this tracked directory. The relative path resolves per
# worktree, so one install covers the main checkout and every linked worktree.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# 1. gofmt — reject staged Go files that aren't gofmt-simplified. Checks the
#    working-tree copy of each staged file, matching how CI's gofmt gate runs.
#    Vendored trees are excluded: they are third-party source committed as
#    upstream published it, and `go mod vendor` is their only writer.
staged_go="$(git diff --cached --name-only --diff-filter=ACM -- '*.go' ':!:vendor/**' ':!:**/vendor/**')"
if [[ -n "$staged_go" ]]; then
    existing=()
    while IFS= read -r f; do
        [[ -f "$REPO_ROOT/$f" ]] && existing+=("$REPO_ROOT/$f")
    done <<< "$staged_go"
    if (( ${#existing[@]} > 0 )); then
        unformatted="$(gofmt -l -s "${existing[@]}")"
        if [[ -n "$unformatted" ]]; then
            echo "pre-commit: these staged Go files are not gofmt-simplified:" >&2
            echo "$unformatted" >&2
            echo "fix with: gofmt -s -w <file>" >&2
            exit 1
        fi
    fi
fi

# 2. lint-backlog — when docs/STATUS.md is staged, validate its format (the
#    Next ID counter, 250-char caps, Deferred triggers; see
#    scripts/docs/lint-backlog.sh) and require the backlog edit to be the only
#    staged file (isolated commits keep rebase conflicts on one file). No-op
#    when STATUS.md is not staged.
"$REPO_ROOT/scripts/docs/lint-backlog.sh" --staged

# 3. em-dash density — when Markdown is staged, hold each file to its baseline
#    ceiling. Same checker `make em-dash-check` and the CI `em-dash` job run,
#    so the verdict here is the verdict there. 410 ms warm on this tree, and
#    skipped outright when no .md is staged, which is most commits.
#
#    Here rather than only in `make check` because of *when* it fires. This is
#    the gate a docs change trips at the very end of a full run, after the
#    heavy phases have been paid for, and it had gone unheeded three sessions
#    running with the rule written down each time (Q699, and the two sessions
#    after it). Commit time is the first moment the answer is both cheap and
#    unavoidable.
#
#    It catches a single branch drifting over its own ceiling. It does NOT
#    catch two branches each sitting *at* one and merging over it, which is a
#    property of the merge result and reachable only from the queue (Q742 for
#    the ratchet, Q743 for the trigger that never runs).
if [[ -n "$(git diff --cached --name-only --diff-filter=ACM -- '*.md')" ]]; then
    "$REPO_ROOT/scripts/docs/check-em-dash.sh"
fi
