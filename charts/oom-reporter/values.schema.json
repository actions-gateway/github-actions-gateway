{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "oom-reporter chart values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "namespaces": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/dnsLabel" } },
    "allNamespaces": { "type": "boolean" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" }
      },
      "required": ["repository"]
    },
    "imagePullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "name": { "type": "string", "minLength": 1 } },
        "required": ["name"]
      }
    },
    "allowFloatingImageTags": { "type": "boolean" },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "podsRoot": { "type": "string", "minLength": 1, "pattern": "^[^/]" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "priorityClassName": { "type": "string" },
        "resources": { "type": "object" }
      },
      "required": ["podsRoot"]
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "placement": { "enum": ["NodeLabel", "Taints"] },
        "nodeLabel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?\\.)?node-restriction\\.kubernetes\\.io/.+$" },
            "value": { "type": "string", "minLength": 1 }
          },
          "required": ["key", "value"]
        },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "priorityClassName": { "type": "string" },
        "resources": { "type": "object" }
      },
      "required": ["placement", "nodeLabel"]
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "apiServerCIDRs": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-fA-F.:]+/[0-9]+$" } },
        "apiServerPorts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        }
      }
    }
  },
  "definitions": {
    "dnsLabel": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$" }
  }
}
